# Template file for 'PineconeMC'
pkgname=PineconeMC
version=11.1.2
revision=1
archs="x86_64 aarch64"
build_style=fetch
nopie=yes
nostrip=yes

case "$XBPS_TARGET_MACHINE" in
    x86_64)
        _arch=x86_64
        checksum=068129b472da7658dd77919250cfb88f38e2b43a65ab92239e0b5a726ba9444d
        ;;
    aarch64)
        _arch=aarch64
        checksum=43efe9403d0f44388605655af0084eda576988515dfb4a4785a2bf898fc71e10
        ;;
    *)
        broken="Unsupported architecture"
        ;;
esac

_AppImage="PineconeMC-Linux-${_arch}.AppImage"
distfiles="https://github.com/ElyPrismLauncher/Launcher/releases/download/${version}/${_AppImage}"

depends="fuse"
short_desc="Fork of Prismlauncher integrated support for Ely.by accounts"
maintainer="Yuki <contact@yukiii.lol>"
license="GPL-3.0-or-later"
homepage="https://pineconemc.ru"
changelog="https://github.com/ElyPrismLauncher/Launcher/releases"

do_install() {
    vmkdir usr/lib/pineconemc
    vinstall "${wrksrc}/${_AppImage}" 755 \
        usr/lib/pineconemc PineconeMC.AppImage

    vmkdir usr/share/applications
    vinstall "$FILESDIR/io.github.elyprismlauncher.ElyPrismLauncher.desktop" \
        644 usr/share/applications

    vmkdir usr/share/icons/hicolor/256x256/apps
    vinstall "$FILESDIR/io.github.elyprismlauncher.ElyPrismLauncher.png" \
        644 usr/share/icons/hicolor/256x256/apps

    vmkdir usr/bin
    ln -s /usr/lib/pineconemc/PineconeMC.AppImage \
        "${DESTDIR}/usr/bin/pineconemc"

    ln -s /usr/lib/pineconemc/PineconeMC.AppImage \
        "${DESTDIR}/usr/bin/elyprismlauncher"
}
