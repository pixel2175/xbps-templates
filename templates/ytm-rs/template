# Template file for 'ytm-rs'
pkgname=ytm-rs
version=2.0.3
revision=1
archs="x86_64"
build_style=fetch
hostmakedepends="tar"
depends="openssl alsa-lib gtk+3 libwebkit2gtk41 libayatana-appindicator dbus"
short_desc="Native YouTube Music desktop client"
maintainer="Pixel <mail@pi66.xyz>"
license="GPL-3.0-only"
homepage="https://github.com/grapedjuice/ytm-rs"
distfiles="${homepage}/releases/download/v${version}/ytm-rs-${version}-linux-x86_64.tar.gz"
checksum=deec141573322c99686bb85b0981bfc25381d97e209b7f084ab259420f804555
nostrip=yes
restricted=yes

do_extract() {
	tar xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/ytm-rs-${version}-linux-x86_64.tar.gz \
		-C ${wrksrc} --strip-components=1
}

do_install() {
	vbin ytm-rs
	vinstall ytm-rs.desktop 644 usr/share/applications
	vinstall ytm-rs.png 644 usr/share/icons/hicolor/256x256/apps
}

post_install() {
	rmdir ${DESTDIR}/usr/lib
}
