# Template file for 'librewolf'
pkgname=librewolf
version=160.0
revision=1
archs="x86_64"
build_style=fetch

_deb="librewolf-${version}-1-linux-x86_64-deb.deb"
distfiles="https://dl.librewolf.net/librewolf/${version}-1/${_deb}"
checksum=65ff7f46f7b6a3d0c5ce2f6bd64d7c6a839d5c1dff76a4ec870e69f892cd789b

hostmakedepends="binutils libarchive"
depends="gtk+3 nss dbus-glib"
short_desc="Privacy-focused Firefox browser"
maintainer="Pi66 <mail@pi66.xyz>"
license="MPL-2.0"
homepage="https://librewolf.net/"
changelog="https://codeberg.org/librewolf"
_autoupdate=codeberg:librewolf/bsys6

do_install() {
	local _debdir="${wrksrc}/deb"
	local _data
	mkdir -p "${_debdir}"
	(cd "${_debdir}" && ar x "${wrksrc}/${_deb}")
	_data=$(find "${_debdir}" -maxdepth 1 -type f -name 'data.tar.*' -print -quit)
	[ -n "${_data}" ] || msg_error "Debian package has no data.tar archive.\n"
	bsdtar -xf "${_data}" -C "${DESTDIR}" --no-same-owner

	vmkdir usr/lib
	mv "${DESTDIR}/usr/share/librewolf" "${DESTDIR}/usr/lib/librewolf"
	ln -sf ../lib/librewolf/librewolf "${DESTDIR}/usr/bin/librewolf"
	vsed -i 's|/usr/share/librewolf|/usr/lib/librewolf|g' \
		"${DESTDIR}/usr/share/applications/librewolf.desktop" \
		"${DESTDIR}/etc/apparmor.d/librewolf"
}
